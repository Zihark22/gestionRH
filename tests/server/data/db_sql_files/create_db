-- Activer le support des clés étrangères dans SQLite (impératif)
PRAGMA foreign_keys = ON;

-- Suppression de la table si elle existe déjà (utile pour les tests)
DROP TABLE IF EXISTS collaborateurs;

-- Création de la table collaborateurs
CREATE TABLE collaborateurs (
    id                  INTEGER PRIMARY KEY AUTOINCREMENT,
    prenom              TEXT NOT NULL,
    nom                 TEXT NOT NULL,
    date_naissance      TEXT NOT NULL, -- Format recommandé : YYYY-MM-DD
    poste               TEXT NOT NULL,
    est_cadre           INTEGER NOT NULL CHECK (est_cadre IN (0, 1)), -- 1 = Cadre, 0 = Non cadre
    position_syntec     TEXT NOT NULL, -- Ex: '1.1', '2.1', '3.1'
    coefficient_syntec  INTEGER NOT NULL, -- Ex: 95, 115, 170...
    date_embauche       TEXT NOT NULL, -- Format recommandé : YYYY-MM-DD
    
    -- Prévention et Management
    manager_id          INTEGER DEFAULT NULL,
    plan_prevention     TEXT CHECK (plan_prevention IN ('Plan A', 'Plan B', 'Plan C', NULL)),
    plan_signe          INTEGER NOT NULL DEFAULT 0 CHECK (plan_signe IN (0, 1)), -- 1 = Oui, 0 = Non

    -- Clé étrangère réflexive (Auto-référence pour le manager)
    FOREIGN KEY (manager_id) REFERENCES collaborateurs(id) ON DELETE SET NULL
);